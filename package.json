{
  "name": "flowchart-ai",
  "version": "0.1.0",
  "description": "Turn plain text into editable mind maps and flowcharts with a tiny AI model that runs fully offline.",
  "main": "electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node dev.js",
    "build": "vite build",
    "start": "vite build && electron .",
    "spike": "node spike/run.js",
    "icon": "electron scripts/icon.js",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always"
  },
  "keywords": [],
  "author": "Saransh <saranshrayguru@gmail.com>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "docx": "^9.7.1",
    "node-llama-cpp": "^3.20.0",
    "pptxgenjs": "^4.0.1"
  },
  "allowScripts": {
    "node-llama-cpp@3.20.0": true,
    "electron@44.3.0": true,
    "electron-builder@26.15.3": true
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@xyflow/react": "^12.11.6",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13"
  },
  "repository": "github:saransh121/flowChart",
  "homepage": "https://github.com/saransh121/flowChart",
  "build": {
    "appId": "com.saransh.flowchart",
    "productName": "flowChart",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/@node-llama-cpp/*cuda*/**"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "saranshrayguru@gmail.com"
    },
    "publish": {
      "provider": "github"
    }
  }
}
